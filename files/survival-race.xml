    function startGame() {
        loadAndMergeFiles(wasmBuildUrl, wasmFiles, function (mergedWasmBlob) {
            const mergedWasmFile = URL.createObjectURL(mergedWasmBlob);

            config.codeUrl = mergedWasmFile;

            const script = document.createElement("script");
            script.src = loaderUrl;

            script.onload = () => {
                StartUnityInstance = function () {
                    createUnityInstance(canvas, config, (progress) => {
                        spinner.style.display = "none";
                        progressBarEmpty.style.display = "";
                        progressBarFull.style.width = `${100 * progress}%`;
                    }).then((unityInstance) => {
                        myGameInstance = unityInstance;

                    }).catch((message) => {
                        console.error("Unity yükleme hatası:", message);
                        alert(message);
                    });
                };

                StartUnityInstance();
            };

            script.onerror = () => {
                console.error("Loader yüklenemedi:", loaderUrl);
            };

            document.body.appendChild(script);
        });
    }

    function InitGame() {
